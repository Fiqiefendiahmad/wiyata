# Copy to .env and replace every placeholder.
APP_ENV=development
APP_NAME=WIYATA
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Platform database only. Never use this as a user database connection.
PLATFORM_DATABASE_URL=postgresql+psycopg://wiyata:change-me@postgres:5432/wiyata

REDIS_URL=redis://redis:6379/0

# Generate a long random secret before use.
APP_SECRET_KEY=replace-with-long-random-secret

# AI is optional. Never put provider keys in frontend variables.
AI_PROVIDER=none
AI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Sandbox policy
SANDBOX_DEFAULT_TTL_MINUTES=30
SANDBOX_MAX_EXECUTION_SECONDS=10
SANDBOX_MAX_RESULT_ROWS=10000
SANDBOX_MAX_RESULT_BYTES=5000000
SANDBOX_ALLOW_DDL=false
SANDBOX_ALLOW_DML=false
