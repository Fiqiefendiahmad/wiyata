# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
APP_NAME=WIYATA
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# PostgreSQL — platform database only
POSTGRES_PASSWORD=change-this-dev-password
PLATFORM_DATABASE_URL=postgresql+asyncpg://wiyata:change-this-dev-password@postgres:5432/wiyata

REDIS_URL=redis://redis:6379/0

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-long-random-secret

# AI — optional. 'none' disables cloud AI.
AI_PROVIDER=none
AI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Frontend (exposed to browser — never put secrets here)
NEXT_PUBLIC_API_URL=/api/v1

# Sandbox policy
SANDBOX_DEFAULT_TTL_MINUTES=30
SANDBOX_MAX_EXECUTION_SECONDS=10
SANDBOX_MAX_RESULT_ROWS=10000
SANDBOX_MAX_RESULT_BYTES=5000000
SANDBOX_ALLOW_DDL=false
SANDBOX_ALLOW_DML=false
